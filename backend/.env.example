PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------
# Preferred: MongoDB Connection String (e.g. mongodb://localhost:27017/scamshield)
# If left blank or server is unreachable, ScamShield operates in degraded mode with persistent local disk storage.
MONGODB_URI=

# ----------------------------------------------------
# AI ANALYSIS ENGINE (Optional Server-Side LLM)
# ----------------------------------------------------
# Supported providers: openai | gemini | anthropic | openai-compatible
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------
# EXTERNAL THREAT INTELLIGENCE (Optional)
# ----------------------------------------------------
# Only configured providers are called. If blank, local static engine operates safely.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
PHISHTANK_API_KEY=

# Enable public non-keyed threat queries for URLhaus if desired (true | false)
ENABLE_PUBLIC_THREAT_INTEL=false
